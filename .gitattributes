# Auto detect text files and normalize line endings to LF
* text=auto

# Frontend
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf

# Backend
*.py text eol=lf
*.sql text eol=lf

# Documentation
*.md text eol=lf
*.mdx text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.zip binary
